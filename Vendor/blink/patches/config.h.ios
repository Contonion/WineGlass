#ifndef BLINK_CONFIG_H_
#define BLINK_CONFIG_H_

// WineGlass iOS build config — features known to be available on iOS/Darwin

// DISABLE_JIT — JIT compiled in; runtime-disabled for the nolinear default (see wg_blink_impl.c). Linear+JIT via WG_LINEAR.
// #define DISABLE_X87
#ifndef WG_PATHB
#define WG_NOLINEAR_JIT  // force kSkew=0: JIT uses software-MMU path (nolinear; 16KB Apple pages)
#endif                   // WG_PATHB (Path B): leave WG_NOLINEAR_JIT undefined -> kSkew=0x088800000000,
                         // JIT emits NATIVE linear loads (host = kSkew+guest_va). Guest memory is one
                         // big pre-mapped region at kSkew (see wg_blink_impl.c + memorymalloc.c).
#define DISABLE_THREADS
                         // ReserveVirtual at load. Real-threads locking is done piecemeal:
                         // WGJIT_LOCK (jit), WG_REAL_ATOMICS (guest TSO), + a machine-list lock.
#define WG_REAL_ATOMICS  // real C11 atomics (+barriers) for the guest's LOCK-prefixed
                         // ops even under DISABLE_THREADS — required for WG_REAL_THREADS
                         // guest threads' lock-free structures not to tear/race.
#define DISABLE_SOCKETS
// #define DISABLE_OVERLAYS
#define DISABLE_VFS
// #define DISABLE_NONPOSIX
// #define DISABLE_ANCILLARY
// #define DISABLE_DISASSEMBLER
// #define DISABLE_BACKTRACE
#define DISABLE_STRACE
// #define DISABLE_METAL
// #define DISABLE_MMX
// #define DISABLE_BCD
// #define DISABLE_ROM
#define DISABLE_BMI2  // MULX/ADCX/ADOX miscompute under iOS interp -> BoringSSL X25519 keygen bad -> TLS internal_error. Force portable bignum.

// Features available on iOS / Darwin ARM64
#define HAVE_SYNC
#define HAVE_INT128
#define HAVE_SA_LEN
#define HAVE_MEMCCPY
#define HAVE_SEEKDIR
#define HAVE_REALPATH
#define HAVE_FDATASYNC
#define HAVE_STRCHRNUL
#define HAVE_VASPRINTF
// #define HAVE_GETENTROPY  // not available on iOS 27 SDK
// #define HAVE_SYS_GETENTROPY
#define HAVE_MAP_SHARED
#define HAVE_DEV_URANDOM
#define HAVE_MAP_ANONYMOUS

